# -----------------------------------------------------------------------------
# n8n-outbound-sequencer-crm-suppression-sync
# Copy to .env (git-ignored) for the Node.js mirror, or set the same variables on
# the n8n host. Every credential below is a placeholder.
# Out of the box nothing is pushed or written: DRY_RUN=true, SANDBOX_MODE=true.
# -----------------------------------------------------------------------------

# --- Safety switches (anything other than an explicit false keeps them on)
DRY_RUN=true
SANDBOX_MODE=true

# --- Node.js server
PORT=3000
WEBHOOK_MAX_BODY_BYTES=1048576

# --- HubSpot webhook authentication
# hubspot_v3: X-HubSpot-Signature-v3 (private/public app webhooks; secret = the app's client secret)
# shared_secret: header WEBHOOK_SHARED_SECRET_HEADER must equal WEBHOOK_SIGNING_SECRET (HubSpot workflow webhooks)
WEBHOOK_AUTH_MODE=hubspot_v3
WEBHOOK_SIGNING_SECRET=YOUR_WEBHOOK_SECRET_HERE
# The exact public URL HubSpot calls (used in the v3 signature), e.g. https://n8n.example.com/webhook/hubspot-suppression
PUBLIC_WEBHOOK_URL=YOUR_PUBLIC_WEBHOOK_URL_HERE
WEBHOOK_SHARED_SECRET_HEADER=x-webhook-secret
SIGNATURE_MAX_AGE_SECONDS=300

# --- Sequencer opt-out webhooks (Smartlead / Instantly -> this workflow)
# Append ?source=smartlead&token=<secret> or ?source=instantly&token=<secret> to the webhook URL in each tool
SEQUENCER_WEBHOOK_SECRET=YOUR_SEQUENCER_WEBHOOK_SECRET_HERE
SEQUENCER_OPT_OUT_EVENTS=lead_unsubscribed,unsubscribed,lead_opted_out
BACK_SYNC_TO_HUBSPOT=true
CROSS_SEQUENCER_SYNC=true

# --- HubSpot (Private App)
HUBSPOT_PRIVATE_APP_TOKEN=YOUR_HUBSPOT_PRIVATE_APP_TOKEN_HERE
HUBSPOT_SANDBOX_PORTAL_ID=YOUR_HUBSPOT_SANDBOX_PORTAL_ID_HERE
HUBSPOT_BASE_URL=https://api.hubapi.com
HUBSPOT_DNC_PROPERTY=outbound_do_not_contact
MAX_CONTACTS_PER_DEAL=50

# --- Suppression rules
SUPPRESS_CLOSED_WON=true
SUPPRESS_OPEN_DEALS=true
SUPPRESS_COMPETITORS=true
SUPPRESS_DNC=true
SUPPRESS_CUSTOMER_LIFECYCLE=true
# Comma-separated pipeline IDs for open-deal suppression (empty = all pipelines)
OPEN_DEAL_PIPELINES=
# Company property and values that mark a competitor
COMPETITOR_PROPERTY=type
COMPETITOR_VALUES=competitor
# Static competitor domains, pushed on every reconciliation
COMPETITOR_DOMAINS=
# Contact properties that mean "do not contact" when true
DNC_PROPERTIES=hs_email_optout,outbound_do_not_contact
# Never blocked (partners, agencies, your own domains)
PROTECTED_DOMAINS=
INTERNAL_DOMAINS=YOUR_COMPANY_DOMAIN_HERE
# Free-mail contacts (gmail.com, outlook.com ...) are blocked by email, never by domain
BLOCK_CONTACT_EMAILS_FOR_FREEMAIL=true

# --- Smartlead
SYNC_SMARTLEAD=true
SMARTLEAD_API_KEY=YOUR_SMARTLEAD_API_KEY_HERE
SMARTLEAD_SANDBOX_API_KEY=YOUR_SMARTLEAD_SANDBOX_API_KEY_HERE
# Optional: associate entries with a Smartlead client (agency accounts)
SMARTLEAD_CLIENT_ID=
SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1

# --- Instantly (API v2 key with block_list_entries:create scope)
SYNC_INSTANTLY=true
INSTANTLY_API_KEY=YOUR_INSTANTLY_API_KEY_HERE
INSTANTLY_SANDBOX_API_KEY=YOUR_INSTANTLY_SANDBOX_API_KEY_HERE
INSTANTLY_BASE_URL=https://api.instantly.ai/api/v2

# --- Batching and reconciliation
BATCH_SIZE=100
RECONCILE_LOOKBACK_HOURS=26
RECONCILE_MAX_DEALS=2000

# --- Optional run log (HTTPS endpoint receiving aggregate JSON summaries)
LOG_WEBHOOK_URL=YOUR_LOG_WEBHOOK_URL_HERE
